{
  "formatVersion": 1,
  "scenarios": [
    {
      "id": "below-threshold-unplugged-shows-card",
      "event": { "event": "battery.level.changed", "metadata": { "batteryLevel": 18, "charging": false } },
      "expected": { "conditionResult": true, "actionSequence": ["low-battery:low-battery-card"], "suppressedActions": [] }
    },
    {
      "id": "charging-suppresses-card",
      "event": { "event": "battery.level.changed", "metadata": { "batteryLevel": 18, "charging": true } },
      "expected": { "conditionResult": false, "actionSequence": [], "suppressedActions": ["low-battery:low-battery-card"] }
    }
  ]
}
