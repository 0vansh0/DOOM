{
  "name": "doom-marketplace-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "build": "npm --prefix ../doom-cli run build && tsc -p tsconfig.json",
    "typecheck": "npm run build",
    "test": "npm run build && vitest run",
    "db:migrate": "tsx src/db/migrate.ts --apply",
    "db:migrate:apply": "tsx src/db/migrate.ts --apply",
    "db:migrate:check": "tsx src/db/migrate.ts --check",
    "db:seed": "tsx src/db/seed.ts",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "seed:admin": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1173.0",
    "@aws-sdk/s3-request-presigner": "^3.1173.0",
    "@fastify/cors": "11.4.3",
    "@fastify/jwt": "10.2.8",
    "@fastify/multipart": "10.1.9",
    "@fastify/rate-limit": "11.2.2",
    "@node-rs/argon2": "2.2.2",
    "doom-mod-cli": "file:../doom-cli",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "postgres": "4.1.1",
    "semver": "7.8.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/semver": "7.8.0",
    "tsx": "4.20.6",
    "typescript": "5.8.3",
    "vitest": "5.1.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
