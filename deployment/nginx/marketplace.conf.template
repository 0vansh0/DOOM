# Render only after DNS, certificate, upstream and trusted proxy topology are approved.
# Configure `set_real_ip_from` only for explicit load-balancer CIDRs; never trust arbitrary X-Forwarded-For.
limit_req_zone $binary_remote_addr zone=doom_api_rate:10m rate=30r/s;

server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name __APPROVED_MARKETPLACE_HOST__;
    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name __APPROVED_MARKETPLACE_HOST__;

    ssl_certificate     __PROVISIONED_FULLCHAIN_PATH__;
    ssl_certificate_key __PROVISIONED_PRIVATE_KEY_PATH__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    ssl_session_cache shared:DOOM_TLS:10m;

    client_max_body_size 10m;
    client_body_timeout 30s;
    client_header_timeout 15s;
    send_timeout 60s;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;

    location / {
        limit_req zone=doom_api_rate burst=60 nodelay;
        proxy_pass http://127.0.0.1:8788;
        proxy_http_version 1.1;
        proxy_connect_timeout 5s;
        proxy_read_timeout 45s;
        proxy_send_timeout 45s;
        proxy_request_buffering on;
        proxy_buffering on;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Overwrite incoming forwarding headers at the public trust boundary.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
    }
}
