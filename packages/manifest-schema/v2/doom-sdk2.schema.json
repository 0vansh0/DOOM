{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "description",
    "author",
    "license",
    "minAndroidApi",
    "modType",
    "entry",
    "icon",
    "capabilities",
    "sdkApiVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+(?![\\s\\S])"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u202A-\\u202E\\u2066-\\u2069]*[^\\s\\u0000-\\u001F\\u007F-\\u009F\\u202A-\\u202E\\u2066-\\u2069][^\\u0000-\\u001F\\u007F-\\u009F\\u202A-\\u202E\\u2066-\\u2069]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]{0,5})(\\.(0|[1-9][0-9]{0,5})){2}(?![\\s\\S])"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u202A-\\u202E\\u2066-\\u2069]*[^\\s\\u0000-\\u001F\\u007F-\\u009F\\u202A-\\u202E\\u2066-\\u2069][^\\u0000-\\u001F\\u007F-\\u009F\\u202A-\\u202E\\u2066-\\u2069]*$"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u202A-\\u202E\\u2066-\\u2069]*[^\\s\\u0000-\\u001F\\u007F-\\u009F\\u202A-\\u202E\\u2066-\\u2069][^\\u0000-\\u001F\\u007F-\\u009F\\u202A-\\u202E\\u2066-\\u2069]*$"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]*(?![\\s\\S])"
    },
    "minAndroidApi": {
      "type": "integer",
      "minimum": 31,
      "maximum": 99
    },
    "modType": {
      "const": "declarative"
    },
    "entry": {
      "const": "mod.json"
    },
    "icon": {
      "type": "string",
      "pattern": "^(?:assets/[a-z0-9][a-z0-9_-]{0,39}\\.png)?(?![\\s\\S])"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "battery.read",
          "overlay.render",
          "clock.read",
          "ui.preview",
          "device.power.read",
          "haptics.vibrate",
          "device.display.read",
          "overlay.preset.apply",
          "app.launch.approved"
        ]
      },
      "minItems": 1,
      "maxItems": 9,
      "uniqueItems": true
    },
    "sdkApiVersion": {
      "const": 2
    }
  }
}
