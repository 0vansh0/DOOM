{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "definitionVersion",
    "triggers",
    "effects",
    "settings"
  ],
  "properties": {
    "definitionVersion": {
      "const": 1
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event",
          "effect"
        ],
        "properties": {
          "event": {
            "const": "battery.charging.started"
          },
          "effect": {
            "const": "charging-ring"
          }
        }
      },
      "minItems": 1,
      "maxItems": 1
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "effect",
          "template",
          "params"
        ],
        "properties": {
          "id": {
            "const": "charging-ring"
          },
          "effect": {
            "const": "overlay.show"
          },
          "template": {
            "const": "battery-ring"
          },
          "params": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "colorSetting",
              "intensitySetting"
            ],
            "properties": {
              "colorSetting": {
                "const": "color"
              },
              "intensitySetting": {
                "const": "intensity"
              }
            }
          }
        }
      },
      "minItems": 1,
      "maxItems": 1
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "color",
        "intensity"
      ],
      "properties": {
        "color": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "default"
          ],
          "properties": {
            "type": {
              "const": "color"
            },
            "default": {
              "type": "string",
              "minLength": 1,
              "maxLength": 7,
              "pattern": "^#[0-9a-fA-F]{6}(?![\\s\\S])"
            }
          }
        },
        "intensity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "min",
            "max",
            "default"
          ],
          "properties": {
            "type": {
              "const": "integer"
            },
            "min": {
              "type": "integer",
              "minimum": 10,
              "maximum": 60
            },
            "max": {
              "type": "integer",
              "minimum": 10,
              "maximum": 60
            },
            "default": {
              "type": "integer",
              "minimum": 10,
              "maximum": 60
            }
          }
        }
      }
    }
  }
}
