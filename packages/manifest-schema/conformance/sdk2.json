[
  {
    "name": "power-card",
    "valid": true,
    "manifest": {
      "schemaVersion": 3,
      "id": "local.powercard",
      "name": "Power Card",
      "version": "1.0.0",
      "description": "Public SDK API 2 example. No privileged operations.",
      "author": "DOOM SDK example author (unverified)",
      "license": "MIT",
      "minAndroidApi": 31,
      "modType": "declarative",
      "entry": "mod.json",
      "icon": "",
      "capabilities": [
        "device.power.read",
        "ui.preview"
      ],
      "sdkApiVersion": 2
    },
    "definition": {
      "definitionVersion": 3,
      "triggers": [
        {
          "event": "device.power.changed",
          "condition": "power-saving",
          "effect": "show"
        }
      ],
      "effects": [
        {
          "id": "show",
          "effect": "ui.preview.show",
          "template": "floating-card",
          "params": {
            "colorSetting": "color",
            "intensitySetting": "intensity"
          }
        }
      ],
      "settings": {
        "color": {
          "type": "color",
          "default": "#B48CFF"
        },
        "intensity": {
          "type": "integer",
          "min": 10,
          "max": 60,
          "default": 45
        }
      }
    }
  },
