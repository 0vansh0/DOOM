{
  "definitionVersion": 4,
  "triggers": [
    {
      "id": "battery-low",
      "event": "battery.level.changed",
      "condition": {
        "op": "all",
        "conditions": [
          {
            "op": "compare",
            "source": "battery.level",
            "comparison": "lessThanOrEqual",
            "value": 20
          },
          {
            "op": "compare",
            "source": "battery.charging",
            "comparison": "equals",
            "value": false
          },
          {
            "op": "compare",
            "source": "setting.enabled",
            "comparison": "equals",
            "value": true
          }
        ]
      },
      "actions": [
        {
          "id": "alert",
          "effect": "ui.preview.show",
          "template": "floating-card",
          "parameters": {
            "message": {
              "$setting": "message"
            },
            "durationMs": {
              "$setting": "durationMs"
            }
          }
        }
      ]
    }
  ],
  "settings": {
    "enabled": {
      "type": "boolean",
      "label": "Enabled",
      "default": true
    },
    "durationMs": {
      "type": "duration",
      "label": "Duration",
      "min": 1000,
      "max": 10000,
      "step": 500,
      "unit": "ms",
      "default": 4000
    },
    "message": {
      "type": "text",
      "label": "Alert message",
      "maxLength": 64,
      "default": "Connect your charger"
    }
  }
}
