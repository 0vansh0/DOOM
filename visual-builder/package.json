{
  "name": "doom-visual-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm --prefix ../doom-cli run build && node scripts/copy-schemas.mjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/copy-schemas.mjs",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "pretest": "npm --prefix ../doom-cli run build",
    "generate:examples": "tsx scripts/generate-examples.ts",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.1",
    "ajv": "^8.17.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "5.1.1"
  }
}
