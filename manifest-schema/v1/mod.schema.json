{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "version",
    "description",
    "minAndroidApi",
    "capabilities",
    "trigger",
    "effect",
    "settings"
  ],
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "pattern": "\\S"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,5})(\\.(0|[1-9][0-9]{0,5})){2}$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "\\S"
    },
    "minAndroidApi": {
      "type": "integer",
      "minimum": 31,
      "maximum": 99
    },
    "capabilities": {
      "const": [
        "overlay"
      ]
    },
    "trigger": {
      "const": "battery.charging"
    },
    "effect": {
      "const": "overlay.glow"
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "color",
        "intensity"
      ],
      "properties": {
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "intensity": {
          "type": "integer",
          "minimum": 10,
          "maximum": 60
        }
      }
    }
  }
}
